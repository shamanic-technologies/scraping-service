{
  "openapi": "3.0.0",
  "info": {
    "title": "Scraping Service",
    "description": "URL scraping service with multi-provider support (Scrape.do default, Firecrawl) - extracts company information from websites",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "http://localhost:3010"
    }
  ],
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    },
    "schemas": {
      "ServiceInfo": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "version"
        ]
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "service": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "service"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "ScrapeResponse": {
        "type": "object",
        "properties": {
          "cached": {
            "type": "boolean"
          },
          "provider": {
            "$ref": "#/components/schemas/ScrapingProvider"
          },
          "requestId": {
            "type": "string"
          },
          "runId": {
            "type": "string"
          },
          "result": {
            "$ref": "#/components/schemas/ScrapeResult"
          }
        },
        "required": [
          "cached",
          "result"
        ]
      },
      "ScrapingProvider": {
        "type": "string",
        "enum": [
          "scrape-do",
          "firecrawl"
        ]
      },
      "ScrapeResult": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "companyName": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "industry": {
            "type": "string",
            "nullable": true
          },
          "employeeCount": {
            "type": "string",
            "nullable": true
          },
          "foundedYear": {
            "type": "number",
            "nullable": true
          },
          "headquarters": {
            "type": "string",
            "nullable": true
          },
          "website": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "linkedinUrl": {
            "type": "string",
            "nullable": true
          },
          "twitterUrl": {
            "type": "string",
            "nullable": true
          },
          "products": {
            "nullable": true
          },
          "services": {
            "nullable": true
          },
          "rawMarkdown": {
            "type": "string",
            "nullable": true
          },
          "rawHtml": {
            "type": "string",
            "nullable": true,
            "description": "Raw page HTML. Populated only when options.formats includes \"rawHtml\"; otherwise null. Request-scoped (not cached)."
          },
          "createdAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "string",
                "format": "date-time"
              }
            ]
          }
        },
        "required": [
          "id",
          "url",
          "companyName",
          "description",
          "industry",
          "employeeCount",
          "foundedYear",
          "headquarters",
          "website",
          "email",
          "phone",
          "linkedinUrl",
          "twitterUrl",
          "rawMarkdown",
          "rawHtml",
          "createdAt"
        ]
      },
      "InsufficientCreditsResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "balance_cents": {
            "type": "number",
            "nullable": true
          },
          "required_cents": {
            "type": "number"
          }
        },
        "required": [
          "error",
          "balance_cents",
          "required_cents"
        ]
      },
      "ScrapeErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "ScrapeRequest": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "provider": {
            "$ref": "#/components/schemas/ScrapingProvider"
          },
          "sourceService": {
            "type": "string"
          },
          "sourceRefId": {
            "type": "string"
          },
          "skipCache": {
            "type": "boolean",
            "default": false
          },
          "enrich": {
            "type": "boolean",
            "description": "Run company-info enrichment. Defaults to true when omitted (current behavior). Set false to skip enrichment and fetch the raw body cheaply (raw-fetch mode)."
          },
          "render": {
            "type": "boolean",
            "description": "Force scrape.do JS rendering (render=true&super=true). Use for client-rendered pages whose content is not in the initial HTML."
          },
          "options": {
            "$ref": "#/components/schemas/ScrapeOptions"
          },
          "outcomeKey": {
            "type": "string",
            "enum": [
              "company_researched"
            ],
            "description": "The outcome this scrape produces, stated by the caller. \"company_researched\" = reading a prospect's company website: on a fresh scrape the scrape run declares it to runs-service, subject = lead-service's company key (`{subjectService: \"lead-service\", subjectId: <normalized domain of url>}`), so every message using that research consumes it. Omitted = nothing declared: the scrape cost rolls into the caller's nearest declaring run (e.g. brand setup). A cache hit spends nothing and declares nothing. Declaration never fails or slows the scrape."
          },
          "brandIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "campaignId": {
            "type": "string"
          },
          "workflowSlug": {
            "type": "string"
          },
          "featureSlug": {
            "type": "string"
          },
          "audienceId": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ]
      },
      "ScrapeOptions": {
        "type": "object",
        "properties": {
          "formats": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "markdown",
                "html",
                "rawHtml",
                "links",
                "screenshot"
              ]
            }
          },
          "onlyMainContent": {
            "type": "boolean"
          },
          "includeTags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "excludeTags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "waitFor": {
            "type": "number"
          },
          "timeout": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 300000
          }
        }
      },
      "ScrapeByUrlResponse": {
        "type": "object",
        "properties": {
          "cached": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "expired": {
            "type": "boolean"
          },
          "result": {
            "$ref": "#/components/schemas/ScrapeResult"
          }
        },
        "required": [
          "cached",
          "expired",
          "result"
        ]
      },
      "ExtractResponse": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/ExtractItemSuccess"
                },
                {
                  "$ref": "#/components/schemas/ExtractItemError"
                }
              ]
            }
          },
          "tokensUsed": {
            "type": "number"
          },
          "runId": {
            "type": "string"
          },
          "cached": {
            "type": "boolean"
          }
        },
        "required": [
          "results",
          "tokensUsed"
        ]
      },
      "ExtractItemSuccess": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "authors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Author"
            }
          },
          "publishedAt": {
            "type": "string",
            "nullable": true
          },
          "cached": {
            "type": "boolean"
          }
        },
        "required": [
          "url",
          "success",
          "authors",
          "publishedAt"
        ]
      },
      "Author": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          }
        },
        "required": [
          "firstName",
          "lastName"
        ]
      },
      "ExtractItemError": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "success": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "url",
          "success",
          "error"
        ]
      },
      "ExtractRequest": {
        "type": "object",
        "properties": {
          "urls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "minItems": 1,
            "maxItems": 10
          },
          "skipCache": {
            "type": "boolean",
            "default": false
          },
          "cacheTtlDays": {
            "type": "integer",
            "minimum": 1,
            "maximum": 365
          },
          "brandIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "campaignId": {
            "type": "string"
          },
          "workflowSlug": {
            "type": "string"
          },
          "featureSlug": {
            "type": "string"
          },
          "audienceId": {
            "type": "string"
          }
        },
        "required": [
          "urls"
        ]
      },
      "MapSuccessResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "urls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "count": {
            "type": "number"
          },
          "source": {
            "type": "string",
            "enum": [
              "map",
              "homepage-links"
            ],
            "description": "map = Firecrawl site map. homepage-links = the map hit its ~18 s ceiling (big site not yet indexed by Firecrawl), so urls are the links found on the homepage instead."
          },
          "runId": {
            "type": "string"
          }
        },
        "required": [
          "success",
          "urls",
          "count",
          "source"
        ]
      },
      "MapErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "success",
          "error"
        ]
      },
      "MapRequest": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "search": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1
          },
          "ignoreSitemap": {
            "type": "boolean"
          },
          "sitemapOnly": {
            "type": "boolean"
          },
          "includeSubdomains": {
            "type": "boolean"
          },
          "brandIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "campaignId": {
            "type": "string"
          },
          "workflowSlug": {
            "type": "string"
          },
          "featureSlug": {
            "type": "string"
          },
          "audienceId": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ]
      },
      "TransferBrandResponse": {
        "type": "object",
        "properties": {
          "updatedTables": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "tableName": {
                  "type": "string"
                },
                "count": {
                  "type": "number"
                }
              },
              "required": [
                "tableName",
                "count"
              ]
            }
          }
        },
        "required": [
          "updatedTables"
        ]
      },
      "TransferBrandRequest": {
        "type": "object",
        "properties": {
          "sourceBrandId": {
            "type": "string",
            "format": "uuid"
          },
          "sourceOrgId": {
            "type": "string"
          },
          "targetOrgId": {
            "type": "string"
          },
          "targetBrandId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "sourceBrandId",
          "sourceOrgId",
          "targetOrgId"
        ]
      },
      "BacklinkCheckResponse": {
        "type": "object",
        "properties": {
          "checkId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "new_links_kept",
              "nothing_new"
            ]
          },
          "brandId": {
            "type": "string"
          },
          "brandDomain": {
            "type": "string"
          },
          "provider": {
            "$ref": "#/components/schemas/BacklinkProvider"
          },
          "outcomeKey": {
            "type": "string",
            "enum": [
              "backlink_earned"
            ]
          },
          "firstCheck": {
            "type": "boolean"
          },
          "windowStart": {
            "type": "string"
          },
          "runId": {
            "type": "string"
          },
          "newLinks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Backlink"
            },
            "description": "Links kept by THIS check (one per new referring domain, verified live)."
          },
          "unitsDeclared": {
            "type": "integer",
            "description": "backlink_earned Units declared on runId by this check (this check's links + any kept earlier whose Unit was not declared yet)."
          },
          "candidatesCount": {
            "type": "integer"
          },
          "rejected": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "referringDomain": {
                  "type": "string"
                },
                "referringUrl": {
                  "type": "string"
                },
                "verification": {
                  "type": "string",
                  "enum": [
                    "not_linking",
                    "unreachable"
                  ]
                }
              },
              "required": [
                "referringDomain",
                "referringUrl",
                "verification"
              ]
            },
            "description": "Candidates not kept now (retried by the brand's next check)."
          },
          "newReferringDomainsCount": {
            "type": "integer"
          },
          "truncated": {
            "type": "boolean",
            "description": "The provider held more rows than one call returns (1000)."
          },
          "costMicroUsd": {
            "type": "number",
            "description": "treg spend of this check in micro-USD (treg-micro-usd), actualized on runId."
          },
          "providerCalls": {
            "type": "integer"
          },
          "checkedAt": {
            "type": "string"
          },
          "replayed": {
            "type": "boolean",
            "description": "true = the stored answer of a completed check with the same idempotencyKey (nothing spent)."
          }
        },
        "required": [
          "checkId",
          "status",
          "brandId",
          "brandDomain",
          "provider",
          "outcomeKey",
          "firstCheck",
          "windowStart",
          "runId",
          "newLinks",
          "unitsDeclared",
          "candidatesCount",
          "rejected",
          "newReferringDomainsCount",
          "truncated",
          "costMicroUsd",
          "providerCalls",
          "checkedAt",
          "replayed"
        ]
      },
      "BacklinkProvider": {
        "type": "string",
        "enum": [
          "dataforseo"
        ],
        "description": "Backlink data provider (a tactic the caller may state; closed list). Absent = dataforseo."
      },
      "Backlink": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Kept link id = the subject of its backlink_earned Unit (subjectService scraping-service)."
          },
          "referringDomain": {
            "type": "string"
          },
          "referringUrl": {
            "type": "string"
          },
          "targetUrl": {
            "type": "string"
          },
          "anchor": {
            "type": "string",
            "nullable": true
          },
          "dofollow": {
            "type": "boolean",
            "nullable": true
          },
          "domainRank": {
            "type": "number",
            "nullable": true,
            "description": "Referring domain authority, DataForSEO rank scale 0-1000 (null = unknown)."
          },
          "spamScore": {
            "type": "number",
            "nullable": true,
            "description": "Provider spam score 0-100 (null = unknown)."
          },
          "firstSeenAt": {
            "type": "string",
            "nullable": true,
            "description": "When the provider first saw this domain link to the brand."
          },
          "verifiedAt": {
            "type": "string",
            "description": "When we fetched the referring page and found the link live."
          },
          "provider": {
            "type": "string"
          },
          "unitDeclared": {
            "type": "boolean"
          },
          "declaredRunId": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "referringDomain",
          "referringUrl",
          "targetUrl",
          "anchor",
          "dofollow",
          "domainRank",
          "spamScore",
          "firstSeenAt",
          "verifiedAt",
          "provider",
          "unitDeclared",
          "declaredRunId"
        ]
      },
      "BacklinkError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Named refusal: brand_required (400), wrong_outcome (400), invalid_competitors (400), Invalid request (400), insufficient_credit (402), brand_not_found (404), check_in_progress (409), brand_has_no_site (422), provider_unavailable / billing_unavailable / key_unavailable / brand_service_unavailable / spend_not_declared / outcome_declaration_failed / service_misconfigured (502)."
          },
          "message": {
            "type": "string"
          },
          "details": {
            "nullable": true
          }
        },
        "required": [
          "error"
        ]
      },
      "BacklinkCheckRequest": {
        "type": "object",
        "properties": {
          "outcomeKey": {
            "type": "string",
            "minLength": 1,
            "description": "The outcome the caller makes. Must be \"backlink_earned\"; anything else = 400 wrong_outcome.",
            "example": "backlink_earned"
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Caller-stated key (e.g. the day). The same key again answers the completed check again: no second spend, no second Unit.",
            "example": "2026-11-09"
          },
          "windowDays": {
            "type": "integer",
            "minimum": 1,
            "maximum": 365,
            "description": "How far back \"new\" reaches on the brand's FIRST check (links whose referring domain first linked within this many days). Later checks reuse that first window start, so they count what appeared since.",
            "example": 60
          },
          "provider": {
            "$ref": "#/components/schemas/BacklinkProvider"
          }
        },
        "required": [
          "outcomeKey",
          "idempotencyKey",
          "windowDays"
        ]
      },
      "BacklinkListResponse": {
        "type": "object",
        "properties": {
          "brandId": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          },
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Backlink"
            }
          }
        },
        "required": [
          "brandId",
          "count",
          "links"
        ]
      },
      "LinkGapResponse": {
        "type": "object",
        "properties": {
          "reportId": {
            "type": "string",
            "format": "uuid"
          },
          "brandId": {
            "type": "string"
          },
          "brandDomain": {
            "type": "string"
          },
          "provider": {
            "$ref": "#/components/schemas/BacklinkProvider"
          },
          "competitors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "minCompetitors": {
            "type": "integer"
          },
          "minDomainRank": {
            "type": "integer"
          },
          "maxSpamScore": {
            "type": "integer"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "domain": {
                  "type": "string"
                },
                "domainRank": {
                  "type": "number",
                  "nullable": true
                },
                "spamScore": {
                  "type": "number",
                  "nullable": true
                },
                "competitorCount": {
                  "type": "integer"
                },
                "competitors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "domain",
                "domainRank",
                "spamScore",
                "competitorCount",
                "competitors"
              ]
            },
            "description": "Domains linking to >= minCompetitors competitors and NOT to the brand, most competitors then highest rank first."
          },
          "scannedCount": {
            "type": "integer"
          },
          "truncated": {
            "type": "boolean"
          },
          "runId": {
            "type": "string"
          },
          "costMicroUsd": {
            "type": "number"
          },
          "providerCalls": {
            "type": "integer"
          },
          "reportedAt": {
            "type": "string"
          },
          "replayed": {
            "type": "boolean"
          }
        },
        "required": [
          "reportId",
          "brandId",
          "brandDomain",
          "provider",
          "competitors",
          "minCompetitors",
          "minDomainRank",
          "maxSpamScore",
          "sources",
          "scannedCount",
          "truncated",
          "runId",
          "costMicroUsd",
          "providerCalls",
          "reportedAt",
          "replayed"
        ]
      },
      "LinkGapRequest": {
        "type": "object",
        "properties": {
          "idempotencyKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "example": "2026-11-09"
          },
          "competitors": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 3
            },
            "minItems": 1,
            "maxItems": 10,
            "description": "Competitor domains or URLs (1-10).",
            "example": [
              "belkins.io",
              "martal.ca",
              "gojiberry.ai"
            ]
          },
          "minCompetitors": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "description": "Keep a source only when it links to at least this many of the competitors.",
            "example": 2
          },
          "minDomainRank": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000,
            "description": "Keep a source only when its rank (DataForSEO 0-1000) is at least this. 0 = no floor.",
            "example": 200
          },
          "maxSpamScore": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "Drop a source whose known spam score is above this.",
            "example": 5
          },
          "provider": {
            "$ref": "#/components/schemas/BacklinkProvider"
          }
        },
        "required": [
          "idempotencyKey",
          "competitors",
          "minCompetitors",
          "minDomainRank",
          "maxSpamScore"
        ]
      }
    },
    "parameters": {}
  },
