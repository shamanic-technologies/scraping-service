    "/orgs/backlinks/checks": {
      "post": {
        "summary": "Check the brand's backlinks: keep new live links, declare one backlink_earned Unit each on the caller's run",
        "description": "Org route called AS the caller's run: headers x-api-key, x-org-id, x-user-id, x-run-id (the run every hold, actual cost and Unit is written on), x-brand-id (exactly ONE brand: the brand whose site is checked), x-campaign-id optional. Reads the referring domains that first linked to the brand's site since the brand's window start (provider via treg, metered on the caller's run: treg-micro-usd held, authorized, actualized), fetches each candidate referring page to verify the link is live now, keeps every verified link new for the brand (one referring domain = one earned link per org x brand, ever), and declares one backlink_earned Unit per kept link on x-run-id (subjectService scraping-service, subjectId = link id). Measured 2026-11-09: one call $0.024 + $0.000036 per row (~$0.026) when nothing is new, ~$0.05 when new domains exist.",
        "security": [
          {
            "apiKey": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BacklinkCheckRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Check answer (new links kept, or nothing new)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BacklinkCheckResponse"
                }
              }
            }
          },
          "400": {
            "description": "brand_required | wrong_outcome | invalid_competitors | Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BacklinkError"
                }
              }
            }
          },
          "402": {
            "description": "insufficient_credit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BacklinkError"
                }
              }
            }
          },
          "404": {
            "description": "brand_not_found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BacklinkError"
                }
              }
            }
          },
          "409": {
            "description": "check_in_progress",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BacklinkError"
                }
              }
            }
          },
          "422": {
            "description": "brand_has_no_site",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BacklinkError"
                }
              }
            }
          },
          "502": {
            "description": "provider_unavailable | billing_unavailable | key_unavailable | brand_service_unavailable | spend_not_declared | outcome_declaration_failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BacklinkError"
                }
              }
            }
          }
        }
      }
    },
